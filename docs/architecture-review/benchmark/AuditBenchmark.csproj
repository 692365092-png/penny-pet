    <AssemblyName>PennyPet.SelfTests</AssemblyName><ImplicitUsings>enable</ImplicitUsings>
    <PennySource Condition="'$(PennySource)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))</PennySource>
