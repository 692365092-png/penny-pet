  <ItemGroup>
    <Compile Include="$(PennySource)/desktop-pet/Features/StickyNotes/DockWindowFacts.cs" />
    <Compile Include="$(PennySource)/desktop-pet/Features/StickyNotes/StickyHostedRuntime.cs" />
    <Compile Include="$(PennySource)/desktop-pet/Features/StickyNotes/StickyPlacementRuntime.cs" />
    <Compile Include="$(PennySource)/desktop-pet/Features/StickyNotes/StickyUiCommand.cs" />
    <ProjectReference Include="$(PennySource)/desktop-pet/PennyPet.Core.csproj" />
  </ItemGroup>
</Project>
