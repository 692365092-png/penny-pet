<Project>
  <!-- Change only PennyVersionPrefix. All other version shapes are derived. -->
  <PropertyGroup>
    <PennyVersionPrefix>1.0.2</PennyVersionPrefix>
    <PennyProductVersion>$(PennyVersionPrefix)</PennyProductVersion>
    <PennyPackageVersion>$(PennyVersionPrefix)</PennyPackageVersion>
    <PennyAssemblyVersion>$(PennyVersionPrefix).0</PennyAssemblyVersion>
  </PropertyGroup>
</Project>
