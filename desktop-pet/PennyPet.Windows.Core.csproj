<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PennyPet</RootNamespace>
    <AssemblyName>PennyPet.Windows.Core</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ApplicationDiagnostics.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="ArtPreloadReservations.cs" />
    <Compile Include="ContactAuthorForm.cs" />
    <Compile Include="DockPulseIndicator.cs" />
    <Compile Include="GlobalKeyboardActivity.cs" />
    <Compile Include="KeyboardOverlay.cs" />
    <Compile Include="LayeredSpriteRenderer.cs" />
    <Compile Include="PennyApplicationHost.cs" />
    <Compile Include="PetAnimationController.cs" />
    <Compile Include="PetAnimationRuntime.cs" />
    <Compile Include="PetArt.cs" />
    <Compile Include="PetBubbleController.cs" />
    <Compile Include="PetContextMenu.cs" />
    <Compile Include="PetForm.cs" />
    <Compile Include="PetKeyboardOverlayController.cs" />
    <Compile Include="PetKeyboardPrivacyPolicy.cs" />
    <Compile Include="PetMenuActions.cs" />
    <Compile Include="PetReminderCoordinator.cs" />
    <Compile Include="PetReminderWindowsCoordinator.cs" />
    <Compile Include="PetSettings.cs" />
    <Compile Include="PetStartupController.cs" />
    <Compile Include="PetStickyWindowCoordinator.cs" />
    <Compile Include="ReminderModels.cs" />
    <Compile Include="ReminderUi.cs" />
    <Compile Include="ReverseEngineeringEasterEgg.cs" />
    <Compile Include="ScaleDialog.cs" />
    <Compile Include="ScheduleItemDialog.cs" />
    <Compile Include="SpeechBubbleForm.cs" />
    <Compile Include="StartupLoadingForm.cs" />
    <Compile Include="StartupRegistration.cs" />
    <Compile Include="StickyAppearanceController.cs" />
    <Compile Include="StickyAppearanceDialog.cs" />
    <Compile Include="StickyDockController.cs" />
    <Compile Include="StickyEditorController.cs" />
    <Compile Include="StickyLinkController.cs" />
    <Compile Include="StickyLinkService.cs" />
    <Compile Include="StickyNativeWindowBehavior.cs" />
    <Compile Include="StickyNoteLinks.cs" />
    <Compile Include="StickyNoteModels.cs" />
    <Compile Include="StickyNoteRepository.cs" />
    <Compile Include="StickyNoteTabs.cs" />
    <Compile Include="StickyNoteWpf.cs" />
    <Compile Include="StickyNotes.cs" />
    <Compile Include="StickyReminderController.cs" />
    <Compile Include="StickyScheduleController.cs" />
    <Compile Include="StickyTodoController.cs" />
    <Compile Include="WpfApplicationHost.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xaml" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="PennyPet.Tools.csproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <PennyGeneratedResourceDir>$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName)\$(Configuration)\$(TargetFramework)\generated</PennyGeneratedResourceDir>
    <PennyReleasePack>$(PennyGeneratedResourceDir)\release-art.ppap</PennyReleasePack>
    <PennyStartupCache>$(PennyGeneratedResourceDir)\startup-art.cache</PennyStartupCache>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PennyReleasePack)"
      LogicalName="PennyPet.Art.ReleasePack" />
    <EmbeddedResource Include="$(PennyStartupCache)"
      LogicalName="PennyPet.Art.StartupCache" />
    <EmbeddedResource Include="..\art\loading.png"
      LogicalName="PennyPet.Startup.Loading" />
    <EmbeddedResource Include="..\art\未标题-1.png"
      LogicalName="PennyPet.ContactAuthor.Image" />
    <EmbeddedResource Include="..\art\svg.png"
      LogicalName="PennyPet.TabIcons.Reference" />
    <EmbeddedResource Include="..\art\pet-art.json"
      LogicalName="PennyPet.Art.Manifest" />
    <PennyArtInputs Include="..\art\pet-art.json" />
    <PennyArtInputs Include="..\art\*.gif" />
  </ItemGroup>
  <Target Name="GeneratePennyArtResources" BeforeTargets="PrepareResources"
    Inputs="@(PennyArtInputs);$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PennyPet.Tools.exe"
    Outputs="$(PennyReleasePack);$(PennyStartupCache)">
    <MakeDir Directories="$(PennyGeneratedResourceDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Command="&quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PennyPet.Tools.exe&quot; --write-release-pack=&quot;$(PennyReleasePack)&quot;" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Command="&quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PennyPet.Tools.exe&quot; --write-startup-cache=&quot;$(PennyStartupCache)&quot;" />
  </Target>
</Project>
