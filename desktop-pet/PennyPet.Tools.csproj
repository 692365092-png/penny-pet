<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PennyPet</RootNamespace>
    <AssemblyName>PennyPet.Tools</AssemblyName>
    <StartupObject>PennyPet.PennyToolsProgram</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="LayeredSpriteRenderer.cs" />
    <Compile Include="Features\Art\AnimationClip.cs" />
    <Compile Include="Features\Art\PetArtFrameRenderer.cs" />
    <Compile Include="PetArt.cs" />
    <Compile Include="PennyPet.ToolsProgram.cs" />
    <Compile Include="Infrastructure\CommandLineArguments.cs" />
    <Compile Include="Infrastructure\ArtCommandRouter.cs" />
    <Compile Include="Infrastructure\Persistence\WindowsDataPaths.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <ProjectReference Include="PennyPet.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <PennyGeneratedResourceDir>$(MSBuildProjectDirectory)\obj\PennyPet.ArtResources\$(Configuration)\$(TargetFramework)</PennyGeneratedResourceDir>
    <PennyReleasePack>$(PennyGeneratedResourceDir)\release-art.ppap</PennyReleasePack>
    <PennyStartupCache>$(PennyGeneratedResourceDir)\startup-art.cache</PennyStartupCache>
  </PropertyGroup>
  <ItemGroup>
    <PennyArtInputs Include="..\art\pet-art.json" />
    <PennyArtInputs Include="..\art\*.gif" />
  </ItemGroup>
  <Target Name="GeneratePennyArtResources" AfterTargets="Build"
    Inputs="@(PennyArtInputs);$(TargetPath)"
    Outputs="$(PennyReleasePack);$(PennyStartupCache)">
    <MakeDir Directories="$(PennyGeneratedResourceDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Command="&quot;$(TargetPath)&quot; --write-release-pack=&quot;$(PennyReleasePack)&quot;" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Command="&quot;$(TargetPath)&quot; --write-startup-cache=&quot;$(PennyStartupCache)&quot;" />
  </Target>
</Project>
