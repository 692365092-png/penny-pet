<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PennyPet</RootNamespace>
    <AssemblyName>PennyPet.SelfTests</AssemblyName>
    <StartupObject>PennyPet.PennySelfTestsProgram</StartupObject>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="PennyPet.SelfTestsProgram.cs" />
    <Compile Include="PennySelfTests.cs" />
    <Compile Include="SelfTestRunner.cs" />
    <Compile Include="Infrastructure\CommandLineArguments.cs" />
    <Compile Include="Infrastructure\SelfTestCommandRouter.cs" />
    <ProjectReference Include="PennyPet.Windows.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Tests\Fixtures\weather-*.json"
      LogicalName="PennyPet.Tests.Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
