<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PennyPet.Tests</RootNamespace>
    <AssemblyName>PennyPet.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Tests\**\*.cs" />
    <!-- Exercise the actual platform-neutral protocol/runtime implementations. -->
    <Compile Include="Features\StickyNotes\DockWindowFacts.cs" />
    <Compile Include="Features\StickyNotes\StickyHostedRuntime.cs" />
    <Compile Include="Features\StickyNotes\StickyPlacementRuntime.cs" />
    <Compile Include="Features\StickyNotes\StickyUiCommand.cs" />
    <Compile Include="Features\StickyNotes\StickyNoteWriter.cs" />
    <Compile Include="Infrastructure\Persistence\PersistenceResult.cs" />
    <ProjectReference Include="PennyPet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Tests\Fixtures\sticky-v*.txt"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>
</Project>
