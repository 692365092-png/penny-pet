<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PennyPet</RootNamespace>
    <AssemblyName>Penny pet</AssemblyName>
    <StartupObject>PennyPet.Program</StartupObject>
    <ApplicationManifest>$(PennyGeneratedManifest)</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Sources are discovered recursively, so feature folders do not need a
       duplicated compile list. -->
  <ItemGroup>
    <Compile Include="**\*.cs"
      Exclude="bin\**;obj\**;Tests\**;PennyPet.AppProgram.cs;PennyPet.SelfTestsProgram.cs;PennyPet.ToolsProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xaml" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19"
      GeneratePathProperty="true" />
    <PackageReference Include="lunar-csharp" Version="1.6.8"
      GeneratePathProperty="true" />
    <EmbeddedResource
      Include="$(PkgCosineKitty_AstronomyEngine)\lib\netstandard2.0\astronomy.dll"
      LogicalName="PennyPet.Dependencies.astronomy.dll" />
    <EmbeddedResource
      Include="$(Pkglunar-csharp)\lib\netstandard2.0\lunar.dll"
      LogicalName="PennyPet.Dependencies.lunar.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PennyPet.Tools.csproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="PennyPet.ArtResources.targets" />

  <PropertyGroup>
    <OfficialOutputFile Condition="'$(OfficialOutputFile)' == ''">$(MSBuildProjectDirectory)\dist\Penny pet.exe</OfficialOutputFile>
  </PropertyGroup>

  <!-- The normal Release build now embeds the art resources and produces the
       distributable single-file EXE. BuildOfficialRelease is only the copy
       step that places that same artifact under dist\. -->
  <Target Name="BuildOfficialRelease" DependsOnTargets="Build">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(OfficialOutputFile)'))" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OfficialOutputFile)" />
  </Target>
</Project>
