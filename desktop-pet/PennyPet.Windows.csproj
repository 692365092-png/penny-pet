<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PennyPet</RootNamespace>
    <AssemblyName>Penny pet</AssemblyName>
    <StartupObject>PennyPet.Program</StartupObject>
    <ApplicationManifest>$(PennyGeneratedManifest)</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- Sources are discovered recursively, so feature folders do not need a
       duplicated compile list. -->
  <ItemGroup>
    <Compile Include="**\*.cs"
      Exclude="bin\**;obj\**;Tests\**;PennyPet.AppProgram.cs;PennyPet.SelfTestsProgram.cs;PennyPet.ToolsProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xaml" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PennyPet.Tools.csproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <PennyGeneratedResourceDir>$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName)\$(Configuration)\$(TargetFramework)\generated</PennyGeneratedResourceDir>
    <PennyReleasePack>$(PennyGeneratedResourceDir)\release-art.ppap</PennyReleasePack>
    <PennyStartupCache>$(PennyGeneratedResourceDir)\startup-art.cache</PennyStartupCache>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PennyReleasePack)"
      LogicalName="PennyPet.Art.ReleasePack" />
    <EmbeddedResource Include="$(PennyStartupCache)"
      LogicalName="PennyPet.Art.StartupCache" />
    <EmbeddedResource Include="..\art\loading.png"
      LogicalName="PennyPet.Startup.Loading" />
    <EmbeddedResource Include="..\art\未标题-1.png"
      LogicalName="PennyPet.ContactAuthor.Image" />
    <EmbeddedResource Include="..\art\svg.png"
      LogicalName="PennyPet.TabIcons.Reference" />
    <EmbeddedResource Include="..\art\pet-art.json"
      LogicalName="PennyPet.Art.Manifest" />
    <PennyArtInputs Include="..\art\pet-art.json" />
    <PennyArtInputs Include="..\art\*.gif" />
  </ItemGroup>
  <Target Name="GeneratePennyArtResources" BeforeTargets="PrepareResources"
    Inputs="@(PennyArtInputs);$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PennyPet.Tools.exe"
    Outputs="$(PennyReleasePack);$(PennyStartupCache)">
    <MakeDir Directories="$(PennyGeneratedResourceDir)" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Command="&quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PennyPet.Tools.exe&quot; --write-release-pack=&quot;$(PennyReleasePack)&quot;" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\.."
      Command="&quot;$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PennyPet.Tools.exe&quot; --write-startup-cache=&quot;$(PennyStartupCache)&quot;" />
  </Target>

  <PropertyGroup>
    <OfficialOutputFile Condition="'$(OfficialOutputFile)' == ''">$(MSBuildProjectDirectory)\dist\Penny pet.exe</OfficialOutputFile>
  </PropertyGroup>

  <!-- The normal Release build now embeds the art resources and produces the
       distributable single-file EXE. BuildOfficialRelease is only the copy
       step that places that same artifact under dist\. -->
  <Target Name="BuildOfficialRelease" DependsOnTargets="Build">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(OfficialOutputFile)'))" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OfficialOutputFile)" />
  </Target>
</Project>
